  "dependencies": { "@supabase/supabase-js": "2.117.3" },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "embedded-postgres": "17.6.0-beta.15",
    "pg": "8.16.3",
    "esbuild": "0.25.12",
    "supabase": "2.121.0"
  }
}
