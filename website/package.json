{
  "name": "rise-roost-website-beta",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/local.mjs",
    "dev:experience": "node scripts/experience-dev.mjs",
    "deploy:experience": "wrangler deploy --config wrangler.experience.toml",
    "check:experience": "wrangler deploy --config wrangler.experience.toml --dry-run",
    "test:experience-hosted": "node tests/experience-hosted.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:all": "npm test && npm run test:browser",
    "deploy": "wrangler deploy",
    "check": "wrangler deploy --dry-run",
    "test:worker": "node tests/worker-smoke.mjs",
    "screenshots": "node tests/capture-evidence.mjs"
  },
  "dependencies": {
    "@simplewebauthn/server": "14.0.3",
    "css-tree": "3.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "wrangler": "4.46.0"
  }
}
